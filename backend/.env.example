# Copy to .env and adjust as needed.

# Directory where uploaded datasets are stored on local disk.
# Relative paths are resolved against the process working directory.
AGENTDS_DATA_DIR=./data/uploads

# Anthropic API key. Only required if AGENTDS_LLM_PROVIDER below is set to
# "anthropic" (default is "ollama", which needs no key). Not needed for
# /quick-stats, or for /train's optional best-effort narration.
# ANTHROPIC_API_KEY=

# LLM provider — one setting for every module (/analyze, /clean, /visualize,
# /recommend, /train, /explain, /report). "ollama" (default) needs a local
# Ollama server running with the model pulled: `ollama pull qwen3:8b`.
# "anthropic" needs ANTHROPIC_API_KEY above.
# AGENTDS_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Context7 MCP server (docs lookups in the editor) works anonymously on a
# free tier by default. Set this only if you want higher rate limits —
# get a key from https://context7.com/dashboard.
# CONTEXT7_API_KEY=
